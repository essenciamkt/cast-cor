---

---

<section id="faq" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-6">
                Perguntas Frequentes
            </h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Tire suas dúvidas sobre nossos produtos e serviços
            </p>
        </div>

        <div class="max-w-3xl mx-auto space-y-6" x-data="{selected: null}">
            <!-- FAQ Item 1 -->
            <div
                class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
            >
                <div
                    @click="selected !== 1 ? selected = 1 : selected = null"
                    class="p-6 cursor-pointer flex items-center justify-between"
                >
                    <h3 class="text-lg md:text-xl font-semibold text-gray-800">
                        Há quanto tempo a CastCor Madeiras está no mercado?
                    </h3>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 text-red-500 transition-transform"
                        :class="{'rotate-180': selected === 1}"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
                <div
                    x-show="selected === 1"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 transform -translate-y-2"
                    x-transition:enter-end="opacity-100 transform translate-y-0"
                    class="px-6 pb-6"
                >
                    <p class="text-gray-600">
                        A CastCor Madeiras está no mercado há 42 anos, sempre no
                        mesmo endereço. Somos uma empresa tradicional com
                        décadas de experiência e confiabilidade na região.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 2 -->
            <div
                class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
            >
                <div
                    @click="selected !== 2 ? selected = 2 : selected = null"
                    class="p-6 cursor-pointer flex items-center justify-between"
                >
                    <h3 class="text-lg md:text-xl font-semibold text-gray-800">
                        Quais tipos de madeiras vocês vendem?
                    </h3>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 text-red-500 transition-transform"
                        :class="{'rotate-180': selected === 2}"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
                <div
                    x-show="selected === 2"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 transform -translate-y-2"
                    x-transition:enter-end="opacity-100 transform translate-y-0"
                    class="px-6 pb-6"
                >
                    <p class="text-gray-600">
                        Trabalhamos principalmente com Maçaranduba e Guajará,
                        madeiras de alta qualidade e resistência para telhados.
                        Todas nossas madeiras são certificadas, garantindo
                        procedência e durabilidade para sua obra.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 3 -->
            <div
                class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
            >
                <div
                    @click="selected !== 3 ? selected = 3 : selected = null"
                    class="p-6 cursor-pointer flex items-center justify-between"
                >
                    <h3 class="text-lg md:text-xl font-semibold text-gray-800">
                        Quais tipos de telhas vocês vendem?
                    </h3>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 text-red-500 transition-transform"
                        :class="{'rotate-180': selected === 3}"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
                <div
                    x-show="selected === 3"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 transform -translate-y-2"
                    x-transition:enter-end="opacity-100 transform translate-y-0"
                    class="px-6 pb-6"
                >
                    <p class="text-gray-600">
                        Oferecemos telhas esmaltadas Karina, telhas Laranjal
                        Paulista (Romana, Portuguesa e Americana) e telhas de
                        fibrocimento Brasilit. Temos as melhores marcas do
                        mercado para garantir qualidade e durabilidade.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 4 -->
            <div
                class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
            >
                <div
                    @click="selected !== 4 ? selected = 4 : selected = null"
                    class="p-6 cursor-pointer flex items-center justify-between"
                >
                    <h3 class="text-lg md:text-xl font-semibold text-gray-800">
                        Vocês fazem entrega?
                    </h3>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 text-red-500 transition-transform"
                        :class="{'rotate-180': selected === 4}"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
                <div
                    x-show="selected === 4"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 transform -translate-y-2"
                    x-transition:enter-end="opacity-100 transform translate-y-0"
                    class="px-6 pb-6"
                >
                    <p class="text-gray-600">
                        Sim! Temos entrega imbatível na região, pontual e
                        rápida. Se faltou algum material, não se preocupe,
                        entregamos complementos sem cobrar frete adicional.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 5 -->
            <div
                class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
            >
                <div
                    @click="selected !== 5 ? selected = 5 : selected = null"
                    class="p-6 cursor-pointer flex items-center justify-between"
                >
                    <h3 class="text-lg md:text-xl font-semibold text-gray-800">
                        Como faço para solicitar um orçamento?
                    </h3>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 text-red-500 transition-transform"
                        :class="{'rotate-180': selected === 5}"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
                <div
                    x-show="selected === 5"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 transform -translate-y-2"
                    x-transition:enter-end="opacity-100 transform translate-y-0"
                    class="px-6 pb-6"
                >
                    <p class="text-gray-600">
                        É simples! Você pode enviar sua lista de materiais pelo
                        WhatsApp, ligando para nós, ou vindo pessoalmente à
                        nossa loja. No WhatsApp, você terá atendimento direto
                        com o dono, rápido e sem enrolação.
                    </p>
                </div>
            </div>

            <!-- FAQ Item 6 -->
            <div
                class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
            >
                <div
                    @click="selected !== 6 ? selected = 6 : selected = null"
                    class="p-6 cursor-pointer flex items-center justify-between"
                >
                    <h3 class="text-lg md:text-xl font-semibold text-gray-800">
                        Tenho um orçamento de outra madeireira, vocês analisam?
                    </h3>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 text-red-500 transition-transform"
                        :class="{'rotate-180': selected === 6}"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
                <div
                    x-show="selected === 6"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 transform -translate-y-2"
                    x-transition:enter-end="opacity-100 transform translate-y-0"
                    class="px-6 pb-6"
                >
                    <p class="text-gray-600">
                        Sim! Nosso compromisso é oferecer qualidade com o menor
                        custo possível. Envie seu orçamento pelo WhatsApp e
                        vamos analisar para chegar em uma proposta irresistível
                        com produtos de qualidade superior.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
