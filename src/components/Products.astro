<script>
    import Glide from "@glidejs/glide";

    document.addEventListener("DOMContentLoaded", () => {
        new Glide(".glide", {
            type: "carousel",
            startAt: 0,
            perView: 3,
            gap: 24,
            breakpoints: {
                1024: {
                    perView: 2,
                },
                768: {
                    perView: 1,
                },
            },
        }).mount();
    });
</script>
