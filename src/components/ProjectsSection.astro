---
interface Project {
    id: number;
    title: string;
    location: string;
    description: string;
    image: string;
}

const projects: Project[] = [
    {
        id: 1,
        title: "Residencial Villa Verde",
        location: "São Paulo, SP",
        description: "Instalação de telhas cerâmicas para condomínio de alto padrão, com 32 unidades e área total de 2.800m².",
        image: "https://placehold.co/1200x800/FF0000/FFFFFF.webp?text=Projeto+1"
    },
    {
        id: 2,
        title: "Centro Empresarial Rio Branco",
        location: "Rio de Janeiro, RJ",
        description: "Cobertura com telhas metálicas termoacústicas para complexo de escritórios, garantindo conforto térmico.",
        image: "https://placehold.co/1200x800/FF0000/FFFFFF.webp?text=Projeto+2"
    },
    {
        id: 3,
        title: "Shopping Recife Center",
        location: "Recife, PE",
        description: "Reforma completa de telhado com sistema de captação de água pluvial integrado, em área de 5.200m².",
        image: "https://placehold.co/1200x800/FF0000/FFFFFF.webp?text=Projeto+3"
    },
    {
        id: 4,
        title: "Residência Costa Verde",
        location: "Florianópolis, SC",
        description: "Projeto residencial com telhas ecológicas e sistema de energia solar integrado ao telhado.",
        image: "https://placehold.co/1200x800/FF0000/FFFFFF.webp?text=Projeto+4"
    }
];
---

<section id="projetos" class="py-20 relative overflow-hidden">
    <!-- Background mesh gradient -->
    <div class="absolute inset-0 bg-gradient-to-tr from-primary/5 via-light to-primary/10 z-0"></div>
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-primary/10 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-1/3 left-0 w-80 h-80 bg-primary/5 rounded-full filter blur-2xl"></div>
    
    <div class="container mx-auto px-4 md:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Projetos Realizados</h2>
            <p class="text-lg text-dark/70">
                Confira alguns dos projetos onde nossos materiais de telhado foram utilizados, demonstrando a qualidade e durabilidade dos produtos CastCor.
            </p>
        </div>
        
        <!-- Glide Carousel -->
        <div class="glide relative">
            <div class="glide__track" data-glide-el="track">
                <ul class="glide__slides">
                    {projects.map(project => (
                        <li class="glide__slide">
                            <div class="bg-white/70 backdrop-blur-md rounded-xl overflow-hidden shadow-xl">
                                <div class="relative h-72 sm:h-96 overflow-hidden">
                                    <img 
                                        src={project.image} 
                                        alt={project.title} 
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                    <!-- Gradient overlay -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-dark/70 to-transparent"></div>
                                    
                                    <!-- Project info overlay -->
                                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                                        <h3 class="text-2xl font-bold mb-2">{project.title}</h3>
                                        <p class="text-white/90 text-sm mb-3">{project.location}</p>
                                        <p class="text-white/80">{project.description}</p>
                                    </div>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
            
            <!-- Carousel Controls -->
            <div class="glide__arrows" data-glide-el="controls">
                <button class="glide__arrow glide__arrow--left absolute left-4 top-1/2 transform -translate-y-1/2 bg-white/80 backdrop-blur-md p-3 rounded-full shadow-lg text-dark hover:bg-primary hover:text-white transition-colors" data-glide-dir="<" aria-label="Slide anterior">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button class="glide__arrow glide__arrow--right absolute right-4 top-1/2 transform -translate-y-1/2 bg-white/80 backdrop-blur-md p-3 rounded-full shadow-lg text-dark hover:bg-primary hover:text-white transition-colors" data-glide-dir=">" aria-label="Próximo slide">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
            
            <!-- Carousel Bullets -->
            <div class="glide__bullets flex justify-center mt-6" data-glide-el="controls[nav]">
                {projects.map((_, index) => (
                    <button 
                        class="w-3 h-3 rounded-full bg-dark/20 mx-1 hover:bg-primary/60 focus:outline-none focus:bg-primary transition-colors" 
                        data-glide-dir={`=${index}`}
                        aria-label={`Ir para slide ${index + 1}`}
                    ></button>
                ))}
            </div>
        </div>
    </div>
</section>

