---

<section id="clientes" class="py-20">
    <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-6">
                Atendemos quem está construindo ou reformando telhado
            </h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Seja você um carpinteiro, pedreiro, arquiteto, engenheiro ou
                proprietário, estamos prontos para entregar o melhor atendimento
                e as melhores madeiras da região.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                cards.map((card) => (
                    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100 flex flex-col items-center text-center transition-all hover:shadow-xl hover:-translate-y-1">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-100 mb-6">
                            <div set:html={card.svgContent} />
                        </div>
                        <h3 class="text-xl font-bold text-gray-800 mb-3">
                            {card.title}
                        </h3>
                        <p class="text-gray-600">{card.description}</p>
                    </div>
                ))
            }
            <div
                class="bg-gradient-to-br from-red-600 to-red-700 rounded-2xl shadow-lg p-8 border border-red-300 flex flex-col items-center text-center text-white"
            >
                <h3 class="text-2xl font-bold mb-3">
                    + 10.000 obras atendidas
                </h3>
                <p class="mb-6">
                    Fale agora pelo WhatsApp e descubra por que milhares de
                    obras confiaram na CastCor Madeiras.
                </p>
                <a
                    href="https://wa.me/552126094545?text=Oi%2C+encontrei+o+site+de+voc%C3%AAs+pelo+Google+e+gostaria+de+mais+informa%C3%A7%C3%B5es."
                    class="inline-flex items-center justify-center px-6 py-4 bg-green-500 text-white font-medium rounded-xl transition-all duration-200 hover:bg-green-600"
                >
                    FALAR COM A CASTCOR AGORA
                </a>
            </div>
        </div>
    </div>
</section>
