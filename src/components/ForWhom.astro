---

---

<section id="clientes" class="py-20">
    <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6">
                Nossos clientes são profissionais que não podem errar
            </h2>
            <p class="text-xl text-slate-600 max-w-3xl mx-auto">
                A qualidade dos nossos produtos é reconhecida pelos melhores
                profissionais do mercado
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Client type 1 -->
            <div
                class="bg-white rounded-2xl shadow-lg p-8 border border-slate-100 flex flex-col items-center text-center transition-all hover:shadow-xl hover:-translate-y-1"
            >
                <div
                    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-orange-100 mb-6"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8 text-orange-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">
                    Engenheiros e arquitetos
                </h3>
                <p class="text-slate-600">
                    Profissionais que precisam de material de qualidade e
                    assistência técnica para entregar projetos impecáveis aos
                    seus clientes.
                </p>
            </div>

            <!-- Client type 2 -->
            <div
                class="bg-white rounded-2xl shadow-lg p-8 border border-slate-100 flex flex-col items-center text-center transition-all hover:shadow-xl hover:-translate-y-1"
            >
                <div
                    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 mb-6"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8 text-blue-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">
                    Construtores e empreiteiros
                </h3>
                <p class="text-slate-600">
                    Profissionais que dependem de fornecimento pontual e
                    materiais sem defeitos para cumprir prazos e orçamentos.
                </p>
            </div>

            <!-- Client type 3 -->
            <div
                class="bg-white rounded-2xl shadow-lg p-8 border border-slate-100 flex flex-col items-center text-center transition-all hover:shadow-xl hover:-translate-y-1"
            >
                <div
                    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-6"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8 text-green-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">
                    Proprietários em reforma
                </h3>
                <p class="text-slate-600">
                    Pessoas que estão construindo ou reformando e buscam
                    orientação técnica e materiais de qualidade para seus lares.
                </p>
            </div>

            <!-- Client type 4 -->
            <div
                class="bg-white rounded-2xl shadow-lg p-8 border border-slate-100 flex flex-col items-center text-center transition-all hover:shadow-xl hover:-translate-y-1"
            >
                <div
                    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-100 mb-6"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8 text-amber-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">
                    Lojas de materiais
                </h3>
                <p class="text-slate-600">
                    Comerciantes que precisam de um fornecedor confiável para
                    atender a demanda de seus clientes com produtos de
                    qualidade.
                </p>
            </div>

            <!-- Client type 5 -->
            <div
                class="bg-white rounded-2xl shadow-lg p-8 border border-slate-100 flex flex-col items-center text-center transition-all hover:shadow-xl hover:-translate-y-1"
            >
                <div
                    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-100 mb-6"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8 text-red-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">
                    Profissionais de obra
                </h3>
                <p class="text-slate-600">
                    Mestres de obra e carpinteiros que valorizam material bem
                    selecionado e cortado com precisão para o melhor resultado.
                </p>
            </div>

            <!-- CTA card -->
            <div
                class="bg-gradient-to-br from-orange-500 to-red-600 rounded-2xl shadow-lg p-8 border border-orange-300 flex flex-col items-center text-center text-white"
            >
                <h3 class="text-2xl font-bold mb-3">Seja nosso cliente</h3>
                <p class="mb-6">
                    Junte-se aos profissionais que escolhem qualidade e
                    confiabilidade para seus projetos.
                </p>
                <a
                    href="#contato"
                    class="inline-flex items-center justify-center px-6 py-4 bg-white text-orange-500 font-medium rounded-xl transition-all duration-200 hover:bg-orange-50"
                >
                    FAZER ORÇAMENTO AGORA MESMO
                </a>
            </div>
        </div>
    </div>
</section>
