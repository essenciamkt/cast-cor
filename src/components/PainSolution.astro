---

---

<section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-4xl mx-auto">
            <h2
                class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800"
            >
                Na CastCor você não vai ouvir 'estamos sem estoque'
            </h2>

            <div class="grid md:grid-cols-2 gap-12 items-center">
                <!-- Pain points -->
                <div
                    class="bg-white p-8 rounded-2xl shadow-lg border border-red-100"
                >
                    <h3 class="text-2xl font-semibold text-gray-800 mb-6">
                        Outros fornecedores:
                    </h3>

                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <span
                                class="text-red-500 font-bold text-xl flex-shrink-0"
                                >❌</span
                            >
                            <p class="text-lg text-gray-700">
                                Sem estoque, entrega demorada
                            </p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span
                                class="text-red-500 font-bold text-xl flex-shrink-0"
                                >❌</span
                            >
                            <p class="text-lg text-gray-700">
                                Atendimento demorado, burocrático
                            </p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span
                                class="text-red-500 font-bold text-xl flex-shrink-0"
                                >❌</span
                            >
                            <p class="text-lg text-gray-700">
                                Madeira sem certificação
                            </p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span
                                class="text-red-500 font-bold text-xl flex-shrink-0"
                                >❌</span
                            >
                            <p class="text-lg text-gray-700">
                                E quando precisa de complementos... é mais frete
                                para pagar
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Solution -->
                <div
                    class="bg-gradient-to-br from-red-50 to-gray-50 p-8 rounded-2xl shadow-lg border border-red-100"
                >
                    <h3 class="text-2xl font-semibold text-gray-800 mb-6">
                        Na CastCor Madeiras:
                    </h3>

                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <span
                                class="text-green-500 font-bold text-xl flex-shrink-0"
                                >✅</span
                            >
                            <p class="text-lg text-gray-700">
                                Entrega imbatível na região
                            </p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span
                                class="text-green-500 font-bold text-xl flex-shrink-0"
                                >✅</span
                            >
                            <p class="text-lg text-gray-700">
                                Atendimento direto com o dono
                            </p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span
                                class="text-green-500 font-bold text-xl flex-shrink-0"
                                >✅</span
                            >
                            <p class="text-lg text-gray-700">
                                Madeiras certificadas com procedência
                            </p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span
                                class="text-green-500 font-bold text-xl flex-shrink-0"
                                >✅</span
                            >
                            <p class="text-lg text-gray-700">
                                Complementos com o mesmo desconto e frete grátis
                            </p>
                        </div>
                    </div>

                    <div
                        class="bg-white/70 backdrop-blur-sm p-6 rounded-xl border border-red-100 shadow-sm mt-6"
                    >
                        <p class="text-lg font-medium text-gray-800">
                            A <span class="text-red-600 font-semibold"
                                >CastCor Madeiras</span
                            > é referência na região há mais de 4 décadas, reconhecida
                            por entregar qualidade, atendimento direto com o dono
                            e uma assistência sem burocracia.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
