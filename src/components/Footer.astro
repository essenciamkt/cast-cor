---

---

<footer class="bg-gray-900 py-16">
    <div class="container mx-auto px-4 md:px-6">
        <div class="grid md:grid-cols-2 gap-12">
            <!-- Company info -->
            <div>
                <div class="mb-6">
                    <div class="flex items-center">
                        <img
                            src="/img/logo.png"
                            alt="CastCor Madeiras Logo"
                            class="h-12 mr-3"
                        />
                        <span class="font-bold text-xl text-white">
                            CastCor Madeiras
                        </span>
                    </div>
                </div>

                <p class="text-gray-300 mb-6 max-w-md">
                    Fornecedor de telhas e madeiras que oferece qualidade com o
                    melhor preço da região. Há 42 anos no mesmo endereço.
                </p>

                <!-- Trust badges -->
                <div class="flex flex-wrap gap-4 mb-6">
                    <div
                        class="bg-gray-800/50 px-4 py-2 rounded-lg flex items-center gap-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-red-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                            ></path>
                        </svg>
                        <span class="text-white text-sm font-medium"
                            >Madeiras Certificadas</span
                        >
                    </div>

                    <div
                        class="bg-gray-800/50 px-4 py-2 rounded-lg flex items-center gap-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-red-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        <span class="text-white text-sm font-medium"
                            >Melhor Custo-Benefício</span
                        >
                    </div>

                    <div
                        class="bg-gray-800/50 px-4 py-2 rounded-lg flex items-center gap-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-red-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        <span class="text-white text-sm font-medium"
                            >Entrega Rápida</span
                        >
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="md:text-right">
                <h2 class="text-2xl font-bold text-white mb-4">
                    Solicite seu orçamento pelo WhatsApp
                </h2>

                <p class="text-gray-300 mb-6 md:ml-auto md:max-w-md">
                    Atendemos pedreiros, arquitetos, engenheiros e proprietários
                    que estão construindo ou reformando telhados.
                </p>

                <div class="flex flex-col md:items-end mb-8">
                    <!-- Phone -->
                    <div class="flex items-center gap-2 mb-2 md:justify-end">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-red-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                        <a
                            href="tel:+552126094545"
                            class="text-white hover:text-red-300 transition-colors"
                            >(21) 2609-4545</a
                        >
                    </div>

                    <!-- WhatsApp -->
                    <div class="flex items-center gap-2 md:justify-end">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-green-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                            ></path>
                        </svg>
                        <a
                            href="https://wa.me/552126094545?text=Ol%C3%A1%2C+vim+pelo+site+e+tenho+interesse+em+material+para+telhado"
                            class="text-white hover:text-green-300 transition-colors"
                            >WhatsApp: (21) 2609-4545</a
                        >
                    </div>
                </div>

                <!-- Final CTA button -->
                <a
                    href="https://wa.me/552126094545?text=Ol%C3%A1%2C+vim+pelo+site+e+tenho+interesse+em+material+para+telhado"
                    class="inline-flex items-center justify-center px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors"
                >
                    ENVIAR ORÇAMENTO PELO WHATSAPP
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 min-w-6 min-h-6 ml-2"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>

        <hr class="border-gray-800 my-10" />

        <!-- Copyright -->
        <div
            class="text-gray-500 text-sm flex flex-col md:flex-row md:justify-between items-center"
        >
            <p class="mb-2 md:mb-0">
                Desenvolvido por <a
                    href="https://essenciamarketing.com.br/"
                    class="underline"
                    target="_blank">Essência Marketing e Gestão</a
                >
            </p>
            <p>
                © {new Date().getFullYear()} CastCor Madeiras. Todos os direitos
                reservados.
            </p>
        </div>
    </div>
</footer>
