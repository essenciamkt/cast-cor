---
interface Advantage {
    title: string;
    description: string;
    icon: string;
}

const advantages: Advantage[] = [
    {
        title: "Durabilidade Superior",
        description: "Nossos materiais possuem vida útil estendida, resistindo às intempéries e mantendo as características originais por muito mais tempo.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`
    },
    {
        title: "Garantia Estendida",
        description: "Todos os nossos produtos são fornecidos com garantia mínima de 15 anos, com certificação e documentação completa.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
    },
    {
        title: "Eficiência Energética",
        description: "Materiais que contribuem para maior isolamento térmico, reduzindo custos com climatização em até 30%.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
    },
    {
        title: "Suporte Técnico",
        description: "Equipe especializada para ajudar na escolha dos materiais ideais para seu projeto e garantir a instalação correta.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`
    },
    {
        title: "Sustentabilidade",
        description: "Produtos eco-friendly com baixo impacto ambiental e possibilidade de reaproveitamento no final da vida útil.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`
    },
    {
        title: "Entrega Rápida",
        description: "Estoque amplo e logística eficiente garantem que seu material chegue em até 48 horas após a confirmação do pedido.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>`
    }
];
---

<section id="vantagens" class="py-20 relative overflow-hidden">
    <!-- Background mesh gradient -->
    <div class="absolute inset-0 bg-gradient-to-bl from-secondary/5 via-light to-primary/5 z-0"></div>
    <div class="absolute left-0 top-1/3 w-64 h-64 bg-primary/10 rounded-full filter blur-3xl opacity-70"></div>
    <div class="absolute right-0 bottom-1/4 w-80 h-80 bg-primary/5 rounded-full filter blur-3xl opacity-60"></div>
    
    <div class="container mx-auto px-4 md:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Por que escolher a CastCor?</h2>
            <p class="text-lg text-dark/70">
                Há mais de 15 anos no mercado, oferecemos mais do que materiais de qualidade — entregamos segurança e tranquilidade para sua construção.
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {advantages.map(advantage => (
                <div class="bg-white/60 backdrop-blur-md rounded-xl p-8 border border-white/30 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden group">
                    <!-- Decorative gradient corner -->
                    <div class="absolute -top-10 -right-10 w-20 h-20 bg-gradient-to-br from-primary/20 to-transparent rounded-full group-hover:scale-150 transition-transform duration-500"></div>
                    
                    <div class="relative z-10">
                        <div class="mb-6" set:html={advantage.icon} />
                        <h3 class="text-xl font-bold mb-3 text-dark">{advantage.title}</h3>
                        <p class="text-dark/70">{advantage.description}</p>
                    </div>
                </div>
            ))}
        </div>
        
        <!-- Stats highlight box -->
        <div class="mt-16 bg-gradient-to-r from-primary/90 to-primary/80 rounded-2xl p-10 shadow-xl text-white relative overflow-hidden">
            <!-- Decorative elements -->
            <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full filter blur-3xl -translate-x-10 -translate-y-40"></div>
            <div class="absolute bottom-0 left-0 w-72 h-72 bg-white/10 rounded-full filter blur-3xl -translate-x-20 translate-y-20"></div>
            
            <div class="relative z-10">
                <h3 class="text-2xl font-bold mb-8 text-center">O impacto de um telhado de qualidade:</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <div class="text-center">
                        <p class="text-4xl font-bold mb-2">98%</p>
                        <p class="text-white/80">De clientes satisfeitos</p>
                    </div>
                    <div class="text-center">
                        <p class="text-4xl font-bold mb-2">30%</p>
                        <p class="text-white/80">Redução em custos energéticos</p>
                    </div>
                    <div class="text-center">
                        <p class="text-4xl font-bold mb-2">15+</p>
                        <p class="text-white/80">Anos de garantia</p>
                    </div>
                    <div class="text-center">
                        <p class="text-4xl font-bold mb-2">0%</p>
                        <p class="text-white/80">Reclamações sobre infiltrações</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
