---
import Button from "./Button.astro";
import { Image } from "astro:assets";
---

<section class="relative py-20">
    <!-- Background pattern -->
    <div class="absolute inset-0 bg-orange-50 overflow-hidden">
        <div class="absolute w-full h-full opacity-10">
            <div
                class="absolute -top-24 -right-24 w-96 h-96 bg-orange-500 rounded-full opacity-30 blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-0 left-0 w-72 h-72 bg-red-500 rounded-full opacity-30 blur-3xl"
            >
            </div>
        </div>
    </div>

    <div class="container relative mx-auto px-4 md:px-6">
        <div
            class="max-w-5xl mx-auto bg-white rounded-3xl overflow-hidden shadow-xl border border-orange-100"
        >
            <div class="md:flex">
                <!-- Left side: Content -->
                <div class="p-8 md:p-10 md:w-3/5 relative overflow-hidden">
                    <!-- Limited time tag -->
                    <div
                        class="absolute top-6 right-6 bg-red-600 text-white px-4 py-1 rounded-full text-sm font-bold flex items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4 mr-1"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        OFERTA EXCLUSIVA POR TEMPO LIMITADO
                    </div>

                    <h2
                        class="text-3xl md:text-4xl font-bold text-slate-800 mb-6 mt-8"
                    >
                        Estamos com condições especiais para pedidos feitos
                        ainda esta semana:
                    </h2>

                    <div class="space-y-6 mb-8">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 text-orange-500">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 12l2 2 4-4m6 2a9 9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-lg font-medium text-slate-800">
                                    Frete com valor reduzido para a região
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 text-orange-500">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 12l2 2 4-4m6 2a9 9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-lg font-medium text-slate-800">
                                    Parcelamento facilitado
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 text-orange-500">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 12l2 2 4-4m6 2a9 9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-lg font-medium text-slate-800">
                                    Atendimento técnico imediato pelo WhatsApp
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8">
                        <Button
                            href="https://wa.me/552126094545?text=Ol%C3%A1%2C+vim+pelo+site+e+tenho+interesse+em+material+para+telhado"
                            fullWidth
                            isWhatsApp
                        >
                            FAZER ORÇAMENTO AGORA MESMO
                        </Button>

                        <div
                            class="mt-4 flex items-center justify-center gap-2 text-slate-600 text-sm"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 text-green-500"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                ></path>
                            </svg>
                            <span>Pagamento 100% seguro</span>

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 text-green-500 ml-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                                ></path>
                            </svg>
                            <span>Parcele em até 10x</span>
                        </div>
                    </div>
                </div>

                <!-- Right side: Image -->
                <div
                    class="hidden md:block md:w-2/5 bg-gradient-to-br from-orange-400 to-red-600 relative"
                >
                    <Image
                        src="https://placehold.co/600x800/orange/white?text=Oferta+Especial"
                        alt="Oferta Especial Telhados"
                        width={600}
                        height={800}
                        class="w-full h-full object-cover object-center opacity-70 mix-blend-multiply"
                    />

                    <!-- Social proof overlay -->
                    <div
                        class="absolute bottom-8 left-1/2 -translate-x-1/2 bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg w-4/5"
                    >
                        <div class="flex items-center gap-3">
                            <div class="flex -space-x-2">
                                <Image
                                    class="w-8 h-8 rounded-full border-2 border-white"
                                    src="https://placehold.co/100/orange/white?text=C"
                                    width={32}
                                    height={32}
                                    alt="Cliente"
                                />
                                <Image
                                    class="w-8 h-8 rounded-full border-2 border-white"
                                    src="https://placehold.co/100/red/white?text=J"
                                    width={32}
                                    height={32}
                                    alt="Cliente"
                                />
                                <Image
                                    class="w-8 h-8 rounded-full border-2 border-white"
                                    src="https://placehold.co/100/blue/white?text=A"
                                    width={32}
                                    height={32}
                                    alt="Cliente"
                                />
                                <div
                                    class="w-8 h-8 rounded-full border-2 border-white bg-orange-100 flex items-center justify-center text-xs font-medium text-orange-600"
                                >
                                    +8
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-yellow-500"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                        ></path>
                                    </svg>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-yellow-500"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                        ></path>
                                    </svg>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-yellow-500"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                        ></path>
                                    </svg>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-yellow-500"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                        ></path>
                                    </svg>
                                </div>
                                <p class="text-xs text-slate-800">
                                    <span class="font-bold">32 pessoas</span> garantiram
                                    essa oferta hoje!
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
