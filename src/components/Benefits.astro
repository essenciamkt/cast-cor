---

---

<section
    id="beneficios"
    class="py-20 bg-gradient-to-br from-blue-50 via-white to-orange-50"
>
    <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6">
                Por que escolher a <span class="text-orange-500"
                    >TelhadosPro</span
                >?
            </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Benefit 1 -->
            <div
                class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-gray-100 relative overflow-hidden group hover:shadow-xl transition-all duration-300"
            >
                <div
                    class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-orange-100 to-amber-50 rounded-full -mr-16 -mt-16 group-hover:scale-110 transition-transform duration-500"
                >
                </div>

                <div class="relative">
                    <div class="flex items-start gap-4 mb-4">
                        <div
                            class="inline-flex items-center justify-center min-w-[48px] w-12 h-12 rounded-xl bg-green-100 text-green-600 flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-slate-800 pt-2">
                            Madeiras certificadas e com procedência
                        </h3>
                    </div>
                    <p class="text-slate-600 pl-16">
                        Trabalhamos apenas com madeira de procedência garantida,
                        certificada e preparada para o melhor desempenho em seu
                        telhado.
                    </p>
                </div>
            </div>

            <!-- Benefit 2 -->
            <div
                class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-gray-100 relative overflow-hidden group hover:shadow-xl transition-all duration-300"
            >
                <div
                    class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-red-100 to-orange-50 rounded-full -mr-16 -mt-16 group-hover:scale-110 transition-transform duration-500"
                >
                </div>

                <div class="relative">
                    <div class="flex items-start gap-4 mb-4">
                        <div
                            class="inline-flex items-center justify-center min-w-[48px] w-12 h-12 rounded-xl bg-green-100 text-green-600 flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-slate-800 pt-2">
                            Telhas das melhores marcas do mercado
                        </h3>
                    </div>
                    <p class="text-slate-600 pl-16">
                        Oferecemos as melhores marcas do mercado com garantia de
                        qualidade e alta durabilidade para sua construção.
                    </p>
                </div>
            </div>

            <!-- Benefit 3 -->
            <div
                class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-gray-100 relative overflow-hidden group hover:shadow-xl transition-all duration-300"
            >
                <div
                    class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-100 to-purple-50 rounded-full -mr-16 -mt-16 group-hover:scale-110 transition-transform duration-500"
                >
                </div>

                <div class="relative">
                    <div class="flex items-start gap-4 mb-4">
                        <div
                            class="inline-flex items-center justify-center min-w-[48px] w-12 h-12 rounded-xl bg-green-100 text-green-600 flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-slate-800 pt-2">
                            20 anos de experiência
                        </h3>
                    </div>
                    <p class="text-slate-600 pl-16">
                        20 anos de experiência atendendo obras de todos os
                        portes, do pequeno construtor às grandes construtoras da
                        região.
                    </p>
                </div>
            </div>

            <!-- Benefit 4 -->
            <div
                class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-gray-100 relative overflow-hidden group hover:shadow-xl transition-all duration-300"
            >
                <div
                    class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-green-100 to-teal-50 rounded-full -mr-16 -mt-16 group-hover:scale-110 transition-transform duration-500"
                >
                </div>

                <div class="relative">
                    <div class="flex items-start gap-4 mb-4">
                        <div
                            class="inline-flex items-center justify-center min-w-[48px] w-12 h-12 rounded-xl bg-green-100 text-green-600 flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-slate-800 pt-2">
                            Atendimento técnico especializado
                        </h3>
                    </div>
                    <p class="text-slate-600 pl-16">
                        Atendimento técnico com foco em resolver seu problema.
                        Nossa equipe é treinada para oferecer o suporte que você
                        precisa em todas as fases da obra.
                    </p>
                </div>
            </div>

            <!-- Benefit 5 -->
            <div
                class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-gray-100 relative overflow-hidden group hover:shadow-xl transition-all duration-300"
            >
                <div
                    class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-amber-100 to-yellow-50 rounded-full -mr-16 -mt-16 group-hover:scale-110 transition-transform duration-500"
                >
                </div>

                <div class="relative">
                    <div class="flex items-start gap-4 mb-4">
                        <div
                            class="inline-flex items-center justify-center min-w-[48px] w-12 h-12 rounded-xl bg-green-100 text-green-600 flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-slate-800 pt-2">
                            Mais de 1.000 obras entregues
                        </h3>
                    </div>
                    <p class="text-slate-600 pl-16">
                        Mais de 1.000 obras entregues com excelência e
                        agilidade, garantindo a satisfação de nossos clientes.
                    </p>
                </div>
            </div>

            <!-- Decorative element -->
            <div
                class="hidden md:block bg-gradient-to-br from-orange-500/20 to-red-500/20 p-6 rounded-xl shadow-lg border border-orange-100 relative overflow-hidden"
            >
                <div class="absolute inset-0 bg-white/30 backdrop-blur-sm">
                </div>
                <div class="relative h-full flex items-center justify-center">
                    <span
                        class="text-4xl font-bold bg-gradient-to-r from-orange-500 to-red-600 bg-clip-text text-transparent"
                    >
                        Qualidade garantida
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
