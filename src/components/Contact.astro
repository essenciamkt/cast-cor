---
import Button from "./Button.astro";
---

<section id="contato" class="py-20">
    <div class="container mx-auto px-4 md:px-6">
        <div
            class="max-w-5xl mx-auto bg-gradient-to-br from-red-600 to-red-700 rounded-3xl overflow-hidden shadow-xl"
        >
            <div class="md:flex">
                <!-- Left side: Content -->
                <div class="p-8 md:p-12 md:w-1/2 text-white">
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">
                        Na CastCor você tem:
                    </h2>
                    <div class="space-y-6 mb-8">
                        <div class="flex items-start gap-4">
                            <div class="bg-white/20 rounded-full p-3 mt-1">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-xl">Segurança</p>
                                <p>Madeira de procedência e certificada.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="bg-white/20 rounded-full p-3 mt-1">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-xl">Agilidade</p>
                                <p>Seu pedido entregue no prazo.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="bg-white/20 rounded-full p-3 mt-1">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-xl">Confiança</p>
                                <p>
                                    Fale direto com o dono e resolva tudo no
                                    WhatsApp.
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="bg-white/20 rounded-full p-3 mt-1">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-xl">Economia real</p>
                                <p>
                                    Analisamos outros orçamentos e cobrimos a
                                    proposta com qualidade superior.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-10">
                        <h3 class="text-2xl font-bold mb-4">Quem somos?</h3>
                        <p class="text-white/90 mb-4">
                            A CastCor Madeiras é uma empresa especializada em
                            madeiras para telhados, atuando há mais de 40 anos
                            no mesmo endereço. Atendemos profissionais da
                            construção civil e clientes que não abrem mão de
                            qualidade e bom atendimento.
                        </p>
                        <p class="text-white/90">
                            Nossa missão é entregar material de qualidade com
                            pontualidade, honestidade e um atendimento que faz
                            você se sentir seguro em cada etapa da obra.
                        </p>
                    </div>
                </div>

                <!-- Right side: WhatsApp Contact -->
                <div class="p-8 md:p-12 md:w-1/2 bg-white">
                    <div class="text-center mb-8">
                        <h3 class="text-2xl font-bold text-gray-800 mb-4">
                            Imagine o seu telhado pronto, com madeira de
                            primeira e entrega sem stress…
                        </h3>
                        <p class="text-gray-600 mb-6">
                            Envie seu orçamento pelo WhatsApp ou fale
                            diretamente conosco.
                        </p>

                        <div class="flex justify-center">
                            <img
                                src="/img/logo.png"
                                alt="CastCor Madeiras Logo"
                                class="h-24 mb-6"
                            />
                        </div>

                        <a
                            href="https://wa.me/552126094545"
                            class="inline-flex items-center justify-center px-6 py-4 text-center font-medium rounded-xl transition-all duration-200 bg-green-500 text-white shadow-lg shadow-green-500/20 hover:shadow-xl hover:shadow-green-500/40 hover:-translate-y-0.5 w-full mb-4"
                        >
                            ENVIAR ORÇAMENTO PELO WHATSAPP
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 min-w-6 min-h-6 ml-2"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                                ></path>
                            </svg>
                        </a>

                        <div class="mt-10 text-left space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="bg-red-100 rounded-full p-3">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6 text-red-600"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium">Telefone</p>
                                    <p>(21) 2609-4545</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-4">
                                <div class="bg-red-100 rounded-full p-3">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6 text-red-600"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        ></path>
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium">Endereço</p>
                                    <p>
                                        Estr. Francisco da Cruz Nunes, 3001 -
                                        Itaipu, Niterói - RJ
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
