---
interface Props {
    href: string;
    variant?: "primary" | "secondary";
    class?: string;
    fullWidth?: boolean;
}

const {
    href,
    variant = "primary",
    class: className = "",
    fullWidth = false,
} = Astro.props;
---

<a
    href={href}
    class:list={[
        "inline-flex items-center justify-center px-6 py-4 text-center font-medium rounded-xl transition-all duration-200",
        fullWidth && "w-full",
        variant === "primary" &&
            "bg-gradient-to-r from-red-600 to-red-700 text-white shadow-lg shadow-red-500/30 hover:shadow-xl hover:shadow-red-500/40 hover:-translate-y-0.5",
        variant === "secondary" &&
            "bg-white/90 text-gray-900 border border-gray-200 hover:bg-white hover:border-gray-300",
        className,
    ]}
>
    <slot />
</a>
