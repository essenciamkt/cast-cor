---
interface Testimonial {
    id: number;
    name: string;
    role: string;
    company: string;
    image: string;
    content: string;
    rating: number;
}

const testimonials: Testimonial[] = [
    {
        id: 1,
        name: "Roberto Almeida",
        role: "Engenheiro Civil",
        company: "Construtora Horizonte",
        image: "https://placehold.co/300x300/CCCCCC/333333.webp?text=RA",
        content: "As telhas cerâmicas da CastCor superaram nossas expectativas. A qualidade do material e a assistência técnica foram impecáveis. Recomendamos para todos os nossos projetos residenciais de alto padrão.",
        rating: 5
    },
    {
        id: 2,
        name: "Carla Mendes",
        role: "Arquiteta",
        company: "Studio Arquitetura",
        image: "https://placehold.co/300x300/CCCCCC/333333.webp?text=CM",
        content: "Trabalhamos com os produtos da CastCor há mais de 5 anos. A durabilidade das telhas e a variedade de opções nos permitem criar projetos personalizados com garantia de qualidade.",
        rating: 5
    },
    {
        id: 3,
        name: "Paulo Santos",
        role: "Proprietário",
        company: "Residencial Vila Serena",
        image: "https://placehold.co/300x300/CCCCCC/333333.webp?text=PS",
        content: "Após uma forte tempestade, fui o único do condomínio que não teve problemas no telhado. O investimento em materiais de qualidade da CastCor valeu cada centavo.",
        rating: 5
    }
];
---

<section id="depoimentos" class="py-20 relative overflow-hidden">
    <!-- Background elements -->
    <div class="absolute inset-0 bg-gradient-to-br from-secondary/5 via-light to-primary/5 z-0"></div>
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-80 h-80 bg-primary/5 rounded-full filter blur-3xl"></div>
    
    <div class="container mx-auto px-4 md:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">O Que Nossos Clientes Dizem</h2>
            <p class="text-lg text-dark/70">
                Confira os depoimentos de clientes que confiam na qualidade dos materiais de telhado da CastCor para seus projetos.
            </p>
        </div>
        
        <!-- Testimonials Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {testimonials.map(testimonial => (
                <div class="bg-white/60 backdrop-blur-md rounded-xl p-8 shadow-lg border border-white/30 relative overflow-hidden group">
                    <!-- Decorative elements -->
                    <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -translate-y-16 translate-x-16 filter blur-xl group-hover:scale-150 transition-transform duration-700"></div>
                    
                    <div class="relative">
                        <!-- Quotation mark -->
                        <div class="absolute -top-2 -left-2 text-primary/20 text-7xl font-serif">"</div>
                        
                        <div class="mb-6 pt-6">
                            <p class="text-dark/80 relative z-10">{testimonial.content}</p>
                        </div>
                        
                        <!-- Rating stars -->
                        <div class="flex mb-4">
                            {Array.from({ length: 5 }).map((_, i) => (
                                <svg 
                                    xmlns="http://www.w3.org/2000/svg" 
                                    class={`h-5 w-5 ${i < testimonial.rating ? 'text-primary' : 'text-gray/30'}`} 
                                    viewBox="0 0 20 20" 
                                    fill="currentColor"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        
                        <!-- Customer info -->
                        <div class="flex items-center">
                            <img 
                                src={testimonial.image} 
                                alt={testimonial.name} 
                                class="w-12 h-12 rounded-full object-cover mr-4"
                                loading="lazy"
                            />
                            <div>
                                <h4 class="font-bold text-dark">{testimonial.name}</h4>
                                <p class="text-sm text-dark/70">{testimonial.role}, {testimonial.company}</p>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
        
        <!-- CTA -->
        <div class="mt-16 text-center">
            <p class="text-lg text-dark/70 mb-6">
                Junte-se aos mais de 10.000 clientes satisfeitos que confiam na qualidade CastCor.
            </p>
            <a href="#orcamento" class="inline-block bg-primary hover:bg-primary-dark text-white font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105">
                Solicitar Orçamento Gratuito
            </a>
        </div>
    </div>
</section>
