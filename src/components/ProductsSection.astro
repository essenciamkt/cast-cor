---
import PrimaryButton from './PrimaryButton.astro';

interface Product {
    id: number;
    name: string;
    description: string;
    image: string;
    features: string[];
}

const products: Product[] = [
    {
        id: 1,
        name: "Telhas Cerâmicas Premium",
        description: "Telhas de cerâmica de alta durabilidade, com design exclusivo e resistência superior contra variações climáticas.",
        image: "https://placehold.co/800x600/FF0000/FFFFFF.webp?text=Telhas+Cerâmicas",
        features: ["Durabilidade de até 30 anos", "Resistência a impactos", "Design exclusivo", "Proteção UV"]
    },
    {
        id: 2,
        name: "Telhas Metálicas Termoacústicas",
        description: "Ideal para galpões e áreas comerciais, oferecendo excelente isolamento térmico e acústico para maior conforto.",
        image: "https://placehold.co/800x600/FF0000/FFFFFF.webp?text=Telhas+Metálicas",
        features: ["Isolamento térmico", "Redução de ruídos", "Instalação rápida", "Baixa manutenção"]
    },
    {
        id: 3,
        name: "Calhas e Rufos",
        description: "Sistema completo de escoamento pluvial em alumínio e aço galvanizado para proteger sua estrutura contra infiltrações.",
        image: "https://placehold.co/800x600/FF0000/FFFFFF.webp?text=Calhas+e+Rufos",
        features: ["Anti-corrosivo", "Fácil limpeza", "Vários tamanhos", "Instalação profissional"]
    },
    {
        id: 4,
        name: "Madeiramento Tratado",
        description: "Estruturas de madeira tratada com processo autoclave que garante alta resistência contra cupins e umidade.",
        image: "https://placehold.co/800x600/FF0000/FFFFFF.webp?text=Madeiramento",
        features: ["Tratamento autoclave", "Anti-cupim", "Secagem controlada", "Corte preciso"]
    }
];
---

<section id="produtos" class="py-20 relative overflow-hidden">
    <!-- Background elements -->
    <div class="absolute inset-0 bg-gradient-to-tr from-light via-gray/10 to-secondary/10 z-0"></div>
    <div class="absolute top-40 left-20 w-96 h-96 bg-primary/10 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-80 h-80 bg-primary/5 rounded-full filter blur-2xl"></div>
    
    <div class="container mx-auto px-4 md:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Nossos Produtos de Alta Performance</h2>
            <p class="text-lg text-dark/70">
                Selecionamos os melhores materiais para garantir durabilidade, beleza e proteção para sua construção ou reforma.
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {products.map(product => (
                <div class="group relative bg-white/50 backdrop-blur-sm rounded-xl overflow-hidden border border-white/30 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                    <div class="h-48 overflow-hidden">
                        <img 
                            src={product.image} 
                            alt={product.name} 
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            loading="lazy"
                        />
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-bold mb-3 text-dark">{product.name}</h3>
                        <p class="text-dark/70 mb-4">{product.description}</p>
                        
                        <ul class="mb-6 space-y-2">
                            {product.features.map(feature => (
                                <li class="flex items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mt-0.5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span class="text-sm">{feature}</span>
                                </li>
                            ))}
                        </ul>
                        
                        <PrimaryButton 
                            text="Solicitar Detalhes" 
                            href="#orcamento" 
                            classes="w-full text-center"
                        />
                    </div>
                    
                    <!-- Glass corner accent -->
                    <div class="absolute top-0 right-0 w-20 h-20 bg-primary/20 backdrop-blur-md -translate-y-10 translate-x-10 transform rotate-45"></div>
                </div>
            ))}
        </div>
        
        <div class="text-center mt-12">
            <p class="text-dark/70 mb-6">
                Não encontrou o material específico que procura? Temos uma ampla variedade de produtos sob demanda.
            </p>
            <PrimaryButton 
                text="Ver Catálogo Completo" 
                href="#orcamento"
            />
        </div>
    </div>
</section>
