---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProductsSection from "../components/ProductsSection.astro";
import AdvantagesSection from "../components/AdvantagesSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FAQSection from "../components/FAQSection.astro";
import OrcamentoSection from "../components/OrcamentoSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="CastCor - Materiais de Telhado de Alta Qualidade"
	description="Adquira materiais de telhado premium com garantia estendida. Telhas, calhas e acessórios com entrega rápida para sua construção ou reforma."
>
	<main>
		<Header />
		<Hero />
		<ProductsSection />
		<AdvantagesSection />
		<ProjectsSection />
		<TestimonialsSection />
		<FAQSection />
		<OrcamentoSection />
		<Footer />
	</main>
</Layout>
