        <!-- Produtos Section -->
        <section class="py-20">
            <div class="container mx-auto px-4 md:px-6">
                <h2
                    class="text-3xl md:text-4xl font-bold mb-12 text-gray-800 text-center"
                >
                    Tudo que você precisa em Madeiras e Telhas para seu Telhado
                    em <span class="text-red-600">{regionString}</span>
                </h2>

                <!-- Madeiras -->
                <div class="mb-16">
                    <h3
                        class="text-2xl font-semibold text-gray-700 mb-8 text-center"
                    >
                        Madeiras Certificadas de Alta Qualidade
                    </h3>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
                    >
                        {
                            woodProducts.map((product) => (
                                <div class="bg-white rounded-lg p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300">
                                    <Image
                                        src={product.image}
                                        alt={product.name}
                                        width={300}
                                        height={200}
                                        class="w-full h-48 object-cover rounded-md mb-4 mx-auto"
                                    />
                                    <h4 class="font-semibold text-xl mb-2 text-gray-800">
                                        {product.name}
                                    </h4>
                                    <p class="text-gray-600 text-sm">
                                        {product.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- Telhas -->
                <div class="mb-12">
                    <h3
                        class="text-2xl font-semibold text-gray-700 mb-8 text-center"
                    >
                        Telhas para Todos os Projetos
                    </h3>
