                                <div class="bg-white rounded-lg p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300">
                                    <Image
                                        src={product.image}
                                        alt={product.name}
                                        width={300}
                                        height={200}
                                        class="w-full h-48 object-cover rounded-md mb-4 mx-auto"
                                    />
                                    <h4 class="font-semibold text-xl mb-2 text-gray-800">
                                        {product.name}
                                    </h4>
                                    <p class="text-gray-600 text-sm">
                                        {product.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <div class="text-center">
                    <a
                        href={`https://wa.me/552127094545?text=Olá, CastCor! Quero saber mais sobre madeiras e telhas para minha obra em ${regionString}.`}
