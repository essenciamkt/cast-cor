                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="mb-1 text-lg sm:text-base font-semibold">
                            WhatsApp - Revestimentos
                        </h3>
                        <p class="text-gray-600 text-sm">(21) 97005-0243</p>
                    </div>
                </a>

                <!-- Website -->
                <a
                    href="https://castcormadeiras.com.br/"
