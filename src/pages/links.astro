                                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="mb-1 text-lg sm:text-base font-semibold">
                            Facebook
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Nos siga no Facebook
                        </p>
                    </div>
                </a>

                <!-- Google Reviews -->
                <a
                    href="https://www.google.com/maps/place/CastCor+Madeiras+e+Revestimentos/@-22.9408426,-43.0533851,801m/data=!3m2!1e3!4b1!4m6!3m5!1s0x99864b5b7a25e1:0x6570556b910cec5d!8m2!3d-22.9408426!4d-43.0508102!16s%2Fg%2F11bxd_1w5m?entry=ttu&g_ep=EgoyMDI1MDUyOC4wIKXMDSoASAFQAw%3D%3D"
