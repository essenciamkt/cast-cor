---
import Layout from "../layouts/Layout.astro";
---

<Layout title="CastCor - Links">
    <div
        class="min-h-screen bg-gradient-to-b from-[#eee] via-white to-[#eee] font-sans"
    >
        <div
            class="max-w-md mx-auto px-5 py-5 min-h-screen flex flex-col sm:px-4"
        >
            <div class="text-center mb-8 text-gray-800">
                <img
                    src="/img/logo.png"
                    alt="CastCor Logo"
                    class="max-w-[300px] sm:max-w-[180px] h-auto mx-auto mb-4 block object-contain shadow-md rounded-lg p-1 bg-white"
                />
                <h1
                    class="mb-2 text-2xl sm:text-xl font-semibold text-gray-900"
                >
                    CastCor Madeiras e Revestimentos
                </h1>
                <p class="text-base text-gray-700">Entre em contato conosco</p>
            </div>

            <div class="flex flex-col gap-4 flex-1">
                <!-- WhatsApp Links -->
                <a
                    href="https://wa.me/5521260944545?text=Oi%2C+encontrei+o+site+de+voc%C3%AAs+pelo+Google+e+gostaria+de+mais+informa%C3%A7%C3%B5es."
                    class="bg-white rounded-2xl p-5 sm:p-4 no-underline text-gray-800 flex items-center gap-5 sm:gap-4 shadow-[0_4px_15px_rgba(0,0,0,0.1)] transition-all duration-300 border-2 border-transparent border-l-[5px] border-l-[#dc143c] hover:-translate-y-1 hover:shadow-[0_8px_25px_rgba(0,0,0,0.15)] hover:border-[#dc143c]"
                    target="_blank"
                >
                    <div class="min-w-[50px] sm:min-w-[40px] text-center">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="w-8 h-8 sm:w-7 sm:h-7 text-[#dc143c]"
                        >
                            <path
                                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="mb-1 text-lg sm:text-base font-semibold">
                            WhatsApp - Madeiras e Portas
                        </h3>
                        <p class="text-gray-600 text-sm">(21) 2609-4545</p>
                    </div>
                </a>

                <a
