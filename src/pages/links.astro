                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="mb-1 text-lg sm:text-base font-semibold">
                            Avalie-nos no Google
                        </h3>
                        <p class="text-gray-600 text-sm">Deixe sua avaliação</p>
                    </div>
                </a>

                <!-- Map -->
                <a
                    href="https://www.google.com/maps/place/CastCor+Madeiras+e+Revestimentos/@-22.9408426,-43.0508102,1001m/data=!3m2!1e3!4b1!4m6!3m5!1s0x99864b5b7a25e1:0x6570556b910cec5d!8m2!3d-22.9408426!4d-43.0508102!16s%2Fg%2F11bxd_1w5m?entry=ttu&g_ep=EgoyMDI1MDIwNS4xIKXMDSoASAFQAw%3D%3D"
