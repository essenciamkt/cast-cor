---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";

// Dados regionais para SEO
const regions = ["Niterói", "Maricá", "São Gonçalo", "Itaboraí"];
const regionString = regions.join(", ");

// Produtos reais baseados na página index.astro
const products = [
    {
        id: "madeiras",
        title: "MADEIRAS CERTIFICADAS",
        icon: "shield",
        items: ["Maçaranduba", "Guajará"],
        image: "/img/madeiras.png",
        whatsappMessage: "Oi, encontrei o site de vocês pelo Google e gostaria de mais informações.",
    },
    {
        id: "telhas-coloniais",
        title: "TELHAS COLONIAIS",
        icon: "home",
        items: ["Telha esmaltada Karina", "Telhas Laranjal Paulista (Romana, Portuguesa e Americana)"],
        image: "/img/telhas-coloniais.png",
        whatsappMessage: "Oi, encontrei o site de vocês pelo Google e gostaria de mais informações.",
    },
    {
        id: "telhas-fibrocimento",
        title: "TELHAS DE FIBROCIMENTO",
        icon: "home",
        items: [
            "Telha de Fibrocimento de qualidade",
            "A melhor telha do mercado",
        ],
        image: "/img/telha-de-fibrocimento.png",
        whatsappMessage: "Oi, encontrei o site de vocês pelo Google e gostaria de mais informações.",
    },
    {
        id: "acessorios",
        title: "ACESSÓRIOS",
        icon: "settings",
        items: ["Manta térmica", "Pregos e parafusos"],
        image: "/img/acessorios.png",
        whatsappMessage: "Oi, encontrei o site de vocês pelo Google e gostaria de mais informações.",
    },
];

// Benefícios da empresa
const benefits = [
    {
        icon: "shield",
        title: "Madeira Certificada",
        description: `Segurança e procedência para sua obra em ${regionString}.`,
    },
    {
        icon: "truck",
        title: "Entrega Imbatível",
        description: `Agilidade e cuidado no transporte para ${regionString}.`,
    },
    {
        icon: "clock",
        title: "42 Anos de Tradição",
        description:
            "Experiência e confiança que você só encontra aqui. Mesmo endereço, sempre!",
    },
    {
        icon: "money",
        title: "Cobrimos Orçamentos",
        description:
            "Traga seu orçamento! Buscamos a melhor condição possível para você.",
    },
    {
        icon: "user",
        title: "Atendimento com o Dono",
        description:
            "Negocie diretamente e tenha suas dúvidas resolvidas na hora.",
    },
    {
        icon: "star",
        title: "Qualidade Garantida",
        description:
            "Compromisso com os melhores materiais para sua obra durar muito mais.",
    },
];

// Público-alvo
const targetAudience = [
    {
        title: "Carpinteiros",
        description: `Madeira de qualidade e entrega pontual para seus projetos em ${regionString}. Fale conosco!`,
    },
    {
        title: "Construtores e Empreiteiros",
        description:
            "Parceria de confiança com fornecimento ágil para suas obras nas quatro cidades. Cumprimos prazos!",
    },
    {
        title: "Proprietários em Reforma/Construção",
        description: `Construindo ou reformando em ${regionString}? Garantimos madeira certificada, telhas de primeira e o melhor preço.`,
    },
    {
        title: "Engenheiros e Arquitetos",
        description:
            "Materiais que atendem às especificações técnicas do seu projeto, com consultoria especializada.",
    },
    {
        title: "Pedreiros e Profissionais de Obra",
        description:
            "A qualidade que você precisa para executar um serviço de excelência. Conte com a CastCor!",
    },
];

// FAQ regional
const faqItems = [
    {
        question: "Há quanto tempo a CastCor Madeiras está no mercado?",
        answer: `A CastCor Madeiras está há mais de 42 anos no mesmo endereço, oferecendo tradição e confiança em ${regionString}.`,
    },
    {
        question: "Quais tipos de madeiras vocês vendem?",
        answer: "Trabalhamos com uma variedade de madeiras certificadas para telhados e construções, incluindo Maçaranduba, Cambará, Garapa, Angelim, Pinus Tratado, entre outras. Consulte nossa equipe para a melhor opção para seu projeto.",
    },
    {
        question: "Quais tipos de telhas vocês vendem?",
        answer: "Oferecemos Telhas Coloniais (Portuguesa, Americana, Laranjal Paulista, Esmaltada Karina), Telhas de Fibrocimento e Telhas Termoacústicas (Sanduíche).",
    },
    {
        question: "Vocês fazem entrega em Maricá, São Gonçalo e Itaboraí? Qual o prazo?",
        answer: `Sim, realizamos entregas em ${regionString}. O prazo de entrega é combinado no momento do orçamento, buscando sempre a maior agilidade possível para sua obra. Consulte-nos para detalhes específicos da sua localidade.`,
    },
    {
        question: "Como faço para solicitar um orçamento via WhatsApp?",
        answer: 'É muito simples! Clique em qualquer um dos botões "WhatsApp" em nosso site. Você será direcionado para uma conversa conosco. Informe os materiais e quantidades que precisa, e a localidade da obra, que nossa equipe responderá rapidamente com seu orçamento.',
    },
    {
        question: "Tenho um orçamento de outra madeireira, vocês analisam?",
        answer: "Sim! Na CastCor Madeiras, nós analisamos outros orçamentos e fazemos o possível para cobrir a proposta, oferecendo sempre o melhor custo-benefício com a qualidade que você merece.",
    },
];

// WhatsApp URL com mensagem regional
const whatsappUrl = `https://wa.me/552126094545?text=Oi%2C+encontrei+o+site+de+voc%C3%AAs+pelo+Google+e+gostaria+de+mais+informa%C3%A7%C3%B5es.+Minha+obra+é+em+${regionString}.`;
---

<Layout
    title={`CastCor: Madeiras e Telhas em ${regionString} - Qualidade Certificada`}
>
    <Header />
    <main>
        <!-- Hero Section Regional -->
        <section class="relative py-20 md:py-32">
            <!-- Background pattern -->
            <div class="absolute inset-0 bg-gray-100 overflow-hidden">
                <div class="absolute right-0 top-0 w-full h-full bg-white/30">
                    <svg
                        class="absolute right-0 top-0 h-full w-full"
                        viewBox="0 0 100 100"
                        preserveAspectRatio="none"
                        fill="none"
                    >
                        <polygon points="0,0 100,0 100,100" fill="white"
                        ></polygon>
                    </svg>
                </div>

                <!-- Abstract shapes -->
                <div
                    class="absolute right-0 top-0 -mr-40 -mt-40 w-80 h-80 bg-red-100 rounded-full opacity-30 blur-3xl"
                >
                </div>
                <div
                    class="absolute left-0 bottom-0 -ml-20 -mb-20 w-60 h-60 bg-red-200 rounded-full opacity-30 blur-3xl"
                >
                </div>
            </div>

            <div class="container relative mx-auto px-4 md:px-6">
                <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
                    <div>
                        <h1
                            class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
                        >
                            CastCor: Madeiras e Telhas em
                            <span class="relative text-red-600 inline-block">
                                {regionString}
                                <svg
                                    class="absolute -bottom-2 left-0 w-full"
                                    viewBox="0 0 100 12"
                                    preserveAspectRatio="none"
                                    height="12"
                                >
                                    <path
                                        d="M0,0 C25,12 75,12 100,0 L100,12 L0,12 Z"
                                        fill="rgb(220, 38, 38, 0.3)"></path>
                                </svg>
                            </span>
                        </h1>
                        <p
                            class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl"
                        >
                            Qualidade certificada, o melhor preço da região e
                            entrega ágil para sua construção ou reforma.
                        </p>

                        <!-- Benefícios destacados -->
                        <div class="mb-8">
                            <div class="flex items-center gap-2 mb-2">
                                <div class="text-red-500">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="text-gray-800 font-medium"
                                    >Atendimento direto com o dono</span
                                >
                            </div>
                            <div class="flex items-center gap-2 mb-2">
                                <div class="text-red-500">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="text-gray-800 font-medium"
                                    >Entrega imbatível em {regionString}</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="text-red-500">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="text-gray-800 font-medium"
                                    >42 anos no mesmo endereço</span
                                >
                            </div>
                        </div>

                        <!-- CTA Section -->
                        <div class="flex flex-col sm:flex-row gap-4 mb-10">
                            <a
                                href={whatsappUrl}
                                target="_blank"
                                class="bg-green-600 text-white font-bold py-4 px-8 rounded-lg shadow-lg hover:bg-green-700 transition duration-300 text-lg inline-flex items-center justify-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    class="w-6 h-6 mr-2"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C6.55 22.5 1.5 17.45 1.5 10.5V8.25V4.5Z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                SOLICITAR ORÇAMENTO PELO WHATSAPP
                            </a>
                        </div>

                        <!-- Trust indicators -->
                        <div
                            class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-8"
                        >
                            <div class="flex items-center gap-2">
                                <div class="text-red-500">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="text-gray-800 font-medium"
                                    >+ 10.000 obras atendidas</span
                                >
                            </div>

                            <div class="flex items-center gap-2">
                                <div class="text-red-500">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <span class="text-gray-800 font-medium"
                                    >+ 40 anos no mesmo local</span
                                >
                            </div>

                            <div class="flex items-center gap-2">
                                <div class="text-red-500">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                        ></path>
                                    </svg>
                                </div>
                                <span class="text-gray-800 font-medium"
                                    >Compromisso com qualidade</span
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Hero image with floating elements -->
                    <div class="relative">
                        <div
                            class="bg-white rounded-2xl shadow-xl overflow-hidden"
                        >
                            <Image
                                src="/img/Design_sem_nome_(3).png"
                                alt="CastCor Madeiras"
                                width={800}
                                height={600}
                                class="w-full h-auto"
                            />
                        </div>

                        <!-- Floating card 1: Ratings -->
                        <div
                            class="absolute -left-6 bottom-1/6 bg-white shadow-lg rounded-lg p-4 max-w-[180px]"
                        >
                            <div class="flex items-center gap-1 mb-1">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 text-yellow-400"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                    ></path>
                                </svg>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 text-yellow-400"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                    ></path>
                                </svg>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 text-yellow-400"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                    ></path>
                                </svg>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 text-yellow-400"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                    ></path>
                                </svg>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 text-yellow-400"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.799-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                                    ></path>
                                </svg>
                            </div>
                            <p class="text-sm font-medium text-gray-800">
                                Tradição e confiança em {regionString}
                            </p>
                        </div>

                        <!-- Floating card 2: Badge -->
                        <div
                            class="absolute -right-6 bottom-2/6 bg-white shadow-lg rounded-lg p-4 max-w-[200px]"
                        >
                            <div class="flex items-center gap-3">
                                <div
                                    class="flex-shrink-0 bg-red-100 p-2 rounded-full"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-8 w-8 text-red-500"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-bold text-gray-800">
                                        Madeira certificada
                                    </p>
                                    <p class="text-xs text-gray-600">
                                        Segurança e durabilidade
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Produtos Section -->
        <section id="produtos" class="py-20">
            <div class="container mx-auto px-4 md:px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold mb-6 text-gray-800">
                        Tudo que você precisa em um só lugar em <span class="text-red-600">{regionString}</span>
                    </h2>
                </div>

                <!-- Products Grid -->
                <div class="grid md:grid-cols-2 gap-8 mb-12">
                    {products.map((product) => (
                        <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100 h-full group hover:shadow-xl hover:border-red-100 transition-all duration-300">
                            <div class="mb-6">
                                <div class="inline-flex items-center justify-center w-16 h-16 rounded-xl bg-red-100 mb-4">
                                    {product.icon === "shield" && (
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                            <path d="M9 12l2 2 4-4"></path>
                                        </svg>
                                    )}
                                    {product.icon === "home" && (
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                        </svg>
                                    )}
                                    {product.icon === "settings" && (
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="3"></circle>
                                            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"></path>
                                        </svg>
                                    )}
                                </div>
                                <h3 class="text-2xl font-bold text-gray-800">
